# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://localhost:5432/text2sql_demo

# NVIDIA API key
# Get your API key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA Model (NIM / AI Foundation Endpoints)
# Options include: meta/llama-3.3-70b-instruct, nvidia/llama-3.1-nemotron-70b-instruct, deepseek-ai/deepseek-r1, etc.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
