# ==============================================================================
# Database Configuration
# ==============================================================================
# PostgreSQL connection string (Neon or local)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# AI / LLM Configuration (Multi-Provider: Google, NVIDIA, Groq, Grok, OpenAI)
# ==============================================================================
# Optional: Force a specific provider ("google", "nvidia", "groq", "grok", "openai")
# If left commented or blank, the provider is automatically detected based on which
# key below is filled in!
# LLM_PROVIDER=google

# ------------------------------------------------------------------------------
# 1. Google Gemini (Recommended - Free, High Quota & Fast)
# Get your free key at: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 2. NVIDIA NIM (AI Foundation Endpoints)
# Get your API key at: https://build.nvidia.com
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# 3. Groq (Ultra Fast Inference)
# Get your API key at: https://console.groq.com
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 4. xAI Grok
# Get your API key at: https://console.x.ai
# ------------------------------------------------------------------------------
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2-latest
# GROK_BASE_URL=https://api.x.ai/v1

# ------------------------------------------------------------------------------
# 5. OpenAI (Optional)
# Get your API key at: https://platform.openai.com
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
